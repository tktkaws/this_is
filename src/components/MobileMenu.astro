---
import { getCollection, render } from 'astro:content';
import type { MarkdownHeading } from 'astro';

const pages = await getCollection('pages');

const categoryRoots = pages
	.filter((p) => p.id !== 'index' && !p.id.includes('/'))
	.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const navItems = await Promise.all(
	categoryRoots.map(async (page) => {
		const href = `/${page.id}/`;
		let tocHeadings: MarkdownHeading[] = [];
		const { headings } = await render(page);
		tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
		return { label: page.data.category || page.data.title, href, tocHeadings };
	})
);
---

<div
	id="mobile-menu"
	class="hidden fixed top-14 left-0 right-0 bottom-0 z-30 bg-[var(--color-bg)] overflow-y-auto lg:hidden"
>
	<div class="p-4 space-y-6">
		<button
			id="mobile-search-trigger"
			class="flex items-center gap-3 w-full px-3 py-2.5 rounded-md text-[var(--color-text)] hover:bg-[var(--color-bg-secondary)] transition-colors"
		>
			<svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
			</svg>
			<span class="text-sm">検索</span>
		</button>

		<nav aria-label="モバイルメニュー">
			<ul class="mobile-nav-list space-y-1">
				{navItems.map((item) => (
					<li>
						{item.tocHeadings.length > 0 ? (
							<details class="group">
								<summary class="flex items-center gap-3 px-3 py-2.5 text-sm text-[var(--color-text)] transition-colors cursor-pointer list-none">
									<svg class="w-5 h-5 shrink-0 transition-transform group-open:rotate-90" fill="currentColor" viewBox="0 0 20 20">
										<path d="M6 4l8 6-8 6V4z" />
									</svg>
									<a href={item.href} class="hover:text-[var(--color-text)]">{item.label}</a>
								</summary>
								<ul class="space-y-1 ml-3 mt-1 border-l border-[var(--color-border)]">
									{item.tocHeadings.map((heading) => (
										<li>
											<a
												href={`${item.href}#${heading.slug}`}
												class:list={[
													'block py-1 text-sm transition-colors text-[var(--color-text-secondary)] hover:text-[var(--color-text)]',
													heading.depth === 3 ? 'pl-6' : 'pl-3',
												]}
											>
												{heading.text}
											</a>
										</li>
									))}
								</ul>
							</details>
						) : (
							<div class="flex items-center gap-3 px-3 py-2.5">
								<svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path d="M6 4l8 6-8 6V4z" />
								</svg>
								<a
									href={item.href}
									class="text-sm text-[var(--color-text)] transition-colors"
								>
									{item.label}
								</a>
							</div>
						)}
					</li>
				))}
			</ul>
		</nav>

		<button
			id="mobile-theme-toggle"
			class="flex items-center gap-3 w-full px-3 py-2.5 rounded-md text-[var(--color-text)] hover:bg-[var(--color-bg-secondary)] transition-colors"
		>
			<svg class="w-5 h-5 shrink-0 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
			</svg>
			<svg class="w-5 h-5 shrink-0 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
			</svg>
			<span class="text-sm dark:hidden">ダークモードに切り替え</span>
			<span class="text-sm hidden dark:inline">ライトモードに切り替え</span>
		</button>
	</div>
</div>

<script>
	const mobileSearchTrigger = document.getElementById('mobile-search-trigger');
	mobileSearchTrigger?.addEventListener('click', () => {
		const searchModal = document.getElementById('search-modal');
		const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
		searchModal?.classList.remove('hidden');
		searchInput?.focus();
	});

	const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
	mobileThemeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
	});
</script>

<style>
	.mobile-nav-list summary::-webkit-details-marker,
	.mobile-nav-list summary::marker {
		display: none;
	}
</style>
